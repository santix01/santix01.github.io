---
import { ui, type Lang } from '../i18n/ui';
import { certs, inProgress, writeups, profile } from '../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const areas = ['defense', 'network', 'general'] as const;
---
<section id="certificaciones" class="section creds" aria-labelledby="certs-title">
  <div class="wrap creds__grid">
    <div class="creds__intro">
      <h2 id="certs-title" data-reveal>{t.certs.title}</h2>
      <p class="muted" data-reveal>{t.certs.issuer}</p>
      {profile.links.credly && <a class="btn" href={profile.links.credly} target="_blank" rel="noopener" data-reveal>Credly</a>}
    </div>
    <div>
      {areas.map((a) => (
        <div class="group" data-reveal>
          <h3 class="group__title">{t.certs.areas[a]}</h3>
          <ul class="ledger">
            {certs.filter((c) => c.area === a).map((c) => (
              <li>
                <a href={c.url} target="_blank" rel="noopener">
                  <span class="ledger__check" aria-hidden="true">
                    <svg viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
                  </span>
                  <span class="ledger__name">{c.name}</span>
                  <span class="ledger__verify">{t.certs.verify}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <div class="group" data-reveal>
        <h3 class="group__title">{t.certs.progress}</h3>
        <ul class="ledger ledger--progress">
          {inProgress.map((c) => (
            <li><span class="ledger__row"><span class="ledger__check ledger__check--open" aria-hidden="true"></span><span class="ledger__name">{c.name}</span><span class="ledger__verify">{c.status[lang]}</span></span></li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<section id="writeups" class="section writeups" aria-labelledby="writeups-title">
  <div class="wrap creds__grid">
    <div class="creds__intro">
      <h2 id="writeups-title" data-reveal>{t.writeups.title}</h2>
      <p class="muted" data-reveal>{t.writeups.text}</p>
      <a class="btn" href="https://github.com/santix01/PortSwigger-Caido-Writeups" target="_blank" rel="noopener" data-reveal>{t.writeups.all}</a>
    </div>
    <ul class="wu">
      {writeups.map((w) => (
        <li data-reveal>
          <a class="wu__item" href={w.url} target="_blank" rel="noopener">
            <p class="wu__meta"><span>{w.category[lang]}</span><span class="muted">{w.platform} · {w.tool}</span></p>
            <h3 class="wu__title">{w.title}</h3>
            <p class="muted">{w.text[lang]}</p>
            <span class="wu__open">{t.writeups.open}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .creds, .writeups { border-top: 1px solid var(--line); }
  .creds__grid { display: grid; grid-template-columns: 1fr 1.6fr; gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .creds__intro { position: sticky; top: 100px; display: grid; gap: 1rem; justify-items: start; }
  .creds__intro p { max-width: 36ch; }
  .group + .group { margin-top: 2.25rem; }
  .group__title { font-size: var(--step--1); color: var(--muted); font-weight: 500; margin-bottom: 0.5rem; }
  .ledger { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
  .ledger li { border-bottom: 1px solid var(--line); }
  .ledger a, .ledger__row {
    display: grid; grid-template-columns: auto 1fr auto; gap: 1rem; align-items: center;
    padding: 1rem 0.25rem; text-decoration: none; transition: background 0.2s, padding 0.3s var(--ease);
  }
  .ledger a:hover { background: var(--bg-2); padding-inline: 0.75rem; }
  .ledger__check {
    display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%;
    border: 1px solid var(--teal); color: var(--teal);
  }
  .ledger__check svg { width: 13px; height: 13px; }
  .ledger__check--open { border-style: dashed; border-color: var(--amber); }
  .ledger__name { font-weight: 500; }
  .ledger__verify { font-size: var(--step--1); color: var(--muted); }
  .ledger a:hover .ledger__verify { color: var(--amber); }

  .wu { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; }
  .wu__item {
    display: grid; gap: 0.6rem; padding: 1.5rem; text-decoration: none;
    border: 1px solid var(--line); border-radius: var(--radius-lg); transition: border-color 0.25s, background 0.25s;
  }
  .wu__item:hover { border-color: #3a5468; background: var(--bg-2); }
  .wu__meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 1rem; font-size: var(--step--1); font-weight: 500; color: var(--teal); }
  .wu__title { font-family: var(--display); font-size: var(--step-2); }
  .wu__open { font-size: var(--step--1); font-weight: 500; color: var(--amber); margin-top: 0.25rem; }

  @media (max-width: 860px) {
    .creds__grid { grid-template-columns: 1fr; }
    .creds__intro { position: static; }
  }
  @media (max-width: 520px) {
    .ledger a, .ledger__row { grid-template-columns: auto 1fr; }
    .ledger__verify { grid-column: 2; margin-top: -0.6rem; }
  }
</style>
