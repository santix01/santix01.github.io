---
import { ui, type Lang } from '../i18n/ui';
import { profile } from '../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const cv = profile.cv[lang];
---
<section id="contacto" class="section contact" aria-labelledby="contact-title">
  <div class="wrap contact__grid">
    <div class="contact__intro">
      <h2 id="contact-title" class="contact__title" data-reveal>{t.contact.title}</h2>
      <p class="contact__text" data-reveal>{t.contact.text}</p>
      <div class="contact__email" data-reveal>
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        <button type="button" class="btn contact__copy" data-copy={profile.email} data-copied={t.contact.copied}>{t.contact.copy}</button>
      </div>
      <ul class="contact__links" data-reveal>
        <li><a class="btn" href={profile.links.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
        <li><a class="btn" href={profile.links.github} target="_blank" rel="noopener">GitHub</a></li>
        {profile.links.htb && <li><a class="btn" href={profile.links.htb} target="_blank" rel="noopener">Hack The Box</a></li>}
        {cv && <li><a class="btn btn--primary" href={cv} download>{t.contact.cv}</a></li>}
      </ul>
    </div>

    <form class="form" data-mailto={profile.email} data-reveal>
      <label>
        <span>{t.contact.name}</span>
        <input name="name" type="text" required autocomplete="name" maxlength="80" />
      </label>
      <label>
        <span>{t.contact.email}</span>
        <input name="email" type="email" required autocomplete="email" maxlength="120" />
      </label>
      <label>
        <span>{t.contact.message}</span>
        <textarea name="message" rows="5" required maxlength="2000"></textarea>
      </label>
      <button class="btn btn--primary" type="submit">{t.contact.send}</button>
      <p class="form__note muted">{t.contact.formNote}</p>
    </form>
  </div>
</section>

<style>
  .contact { border-top: 1px solid var(--line); }
  .contact__grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(2.5rem, 6vw, 6rem); align-items: start; }
  .contact__title { font-size: var(--step-4); line-height: 0.95; letter-spacing: -0.025em; }
  .contact__text { margin-top: 1.5rem; font-size: var(--step-1); line-height: 1.5; max-width: 38ch; color: #c6d3dc; }
  .contact__email { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.25rem; margin-top: 2rem; }
  .contact__email a { font: 500 var(--step-1)/1.3 var(--mono); color: var(--amber); text-underline-offset: 5px; word-break: break-all; }
  .contact__copy { padding: 0.6rem 1rem; font-size: var(--step--1); }
  .contact__links { list-style: none; padding: 0; margin: 2rem 0 0; display: flex; flex-wrap: wrap; gap: 0.6rem; }

  .form { display: grid; gap: 1.1rem; background: var(--bg-2); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: clamp(1.25rem, 3vw, 2rem); }
  .form label { display: grid; gap: 0.4rem; font-size: var(--step--1); font-weight: 500; color: var(--muted); }
  .form input, .form textarea {
    font: 400 var(--step-0)/1.5 var(--body); color: var(--text);
    background: var(--bg); border: 1px solid var(--line); border-radius: var(--radius-sm);
    padding: 0.75rem 0.85rem; resize: vertical; transition: border-color 0.2s;
  }
  .form input:focus, .form textarea:focus { outline: none; border-color: var(--amber); }
  .form button { justify-self: start; }
  .form__note { font-size: 0.8rem; }

  @media (max-width: 860px) { .contact__grid { grid-template-columns: 1fr; } }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
    const label = b.textContent;
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy!);
        b.textContent = b.dataset.copied!;
        setTimeout(() => (b.textContent = label), 1800);
      } catch { /* sin portapapeles: el correo sigue visible como enlace */ }
    });
  });

  document.querySelectorAll<HTMLFormElement>('form[data-mailto]').forEach((f) => {
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(f);
      const name = String(d.get('name') || '').trim();
      const from = String(d.get('email') || '').trim();
      const msg = String(d.get('message') || '').trim();
      const subject = `Portafolio — ${name}`;
      const body = `${msg}\n\n— ${name} <${from}>`;
      window.location.href = `mailto:${f.dataset.mailto}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });
  });
</script>
