---
import '../styles/global.css';
import { ui, homeHref, type Lang } from '../i18n/ui';
import { profile } from '../data/site';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  altHref: string; // misma página en el otro idioma
}
const { lang, title, description, altHref } = Astro.props;
const t = ui[lang];
const pageTitle = title ? `${title} — ${profile.shortName}` : t.htmlTitle;
const desc = description ?? t.description;
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const alt = new URL(altHref, site).href;
const ogImage = new URL(`/og-${lang}.png`, site).href;
const csp = [
  "default-src 'self'",
  "script-src 'self'",
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data: https:",
  "font-src 'self'",
  "connect-src 'self' https://api.github.com",
  "base-uri 'self'",
  "form-action 'self' mailto:",
  "object-src 'none'",
  'upgrade-insecure-requests',
].join('; ');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role[lang],
  url: new URL(homeHref(lang), site).href,
  sameAs: [profile.links.github, profile.links.linkedin].filter(Boolean),
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#0e1821" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={lang === 'es' ? 'en' : 'es'} href={alt} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', site).href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'es' ? 'es_CO' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
    <Nav lang={lang} altHref={altHref} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <div class="cursor" aria-hidden="true"></div>
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
